[run]
# Где искать исходники для покрытия
source = bot

# Исключить из покрытия
omit =
    bot/tests/*
    bot/__pycache__/*
    bot/*/__pycache__/*
    bot/*/*/__pycache__/*
    bot/.pytest_cache/*
    */.venv/*
    */venv/*
    */tests/*
    */test_*.py
    */__init__.py
    bot/config_dir/config.py
    bot/config_dir/logger_config.py
    bot/core/main.py
    bot/core/handlers/commands.py 

# Использовать относительные пути
relative_files = True

[report]
# Показывать строки которые не покрыты тестами
show_missing = True

# Точность процентов
precision = 2

# Сортировка по проценту покрытия
sort = Cover

# Пропустить пустые файлы
skip_empty = True

# Исключить из отчёта
exclude_lines =
    # Стандартные исключения
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    # Логирование
    log_event
    logger.
    print\(

[html]
# Директория для HTML отчёта
directory = bot/htmlcov

[xml]
# Файл для XML отчёта
output = bot/coverage.xml
